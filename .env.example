# ============================================================
# Guru Studio - environment variables (TEMPLATE ONLY)
# ============================================================
# 1. Copy this file. Do NOT put real passwords in this file.
# 2. Put the real values in your IDE run settings (IntelliJ) or your hosting
#    provider's environment settings. Spring Boot does not read a .env file by itself.
# 3. Never commit a file with real values to GitHub.
# ============================================================

# ---- MySQL (backend) ----
DB_URL=jdbc:mysql://localhost:3306/gurustudio
DB_USERNAME=YOUR_MYSQL_USERNAME
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# ---- Login token signing (backend) ----
# Any random text of at least 32 characters. Keep it secret.
JWT_SECRET=REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS

# ---- Admin login (backend) ----
# The single admin account. Choose these yourself. There is no public sign-up for admins.
ADMIN_USERNAME=YOUR_ADMIN_USERNAME
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_AT_LEAST_8_CHARACTERS

# ---- Cloudinary photo storage (backend) ----
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# ---- Website address allowed to call the backend (backend, CORS) ----
# Local development uses http://localhost:5173 automatically.
# In production, set this to your real frontend address, for example https://www.gurustudio.example
FRONTEND_URL=http://localhost:5173

# ---- Backend address used by the React app (frontend) ----
# Put this in frontend/.env (Vite reads that file, not this one). Local value shown:
VITE_API_URL=http://localhost:8080
